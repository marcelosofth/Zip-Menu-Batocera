#!/bin/bash
# Wrapper GLOBAL do emulatorlauncher: .zip com varios arquivos -> menu
# Instalado por zipmenu-hook.sh (bind mount sobre /usr/bin/emulatorlauncher),
# nao precisa de es_systems_*.cfg.

# Sistemas onde o menu NAO deve aparecer: um nome por linha neste arquivo
# (mesmo nome da pasta em /userdata/roms). Qualquer outro sistema tem o menu.
EXCL=/userdata/system/zipmenu-exclude.txt

SELF=/userdata/system/zipmenu-launch.sh
REAL=/tmp/emulatorlauncher.real
[ -s "$REAL" ] || REAL=emulatorlauncher   # fallback (sem hook instalado)

# modo menu (roda dentro do xterm) - menu proprio em ANSI, sem dialog
if [ "$1" = "--pick" ]; then
  ZIP="$2"; OUT="$3"
  mapfile -t FILES < <(unzip -Z1 "$ZIP" | grep -v '/$' | LC_ALL=C sort -f)
  N=${#FILES[@]}

  # janela 4:3 (caractere e ~2x mais alto que largo: W = H*8/3).
  # Tamanho = 80% da tela +40% (112%), limitado para caber com 1 linha/coluna de margem.
  # Recalcula se o terminal mudar de tamanho (xterm -fullscreen redimensiona depois de abrir).
  layout() {
    R=""; C=""
    read -r R C < <(stty size 2>/dev/null)
    if [ "${R:-0}" -lt 1 ] || [ "${C:-0}" -lt 1 ]; then
      R=$(tput lines 2>/dev/null || echo 40); C=$(tput cols 2>/dev/null || echo 120)
    fi
    H=$((R*112/100)); W=$((H*8/3))
    if [ "$H" -gt $((R-2)) ]; then H=$((R-2)); W=$((H*8/3)); fi
    if [ "$W" -gt $((C-2)) ]; then W=$((C-2)); H=$((W*3/8)); fi
    [ "$H" -lt 8 ] && H=8
    Y0=$(( (R-H)/2 + 1 )); X0=$(( (C-W)/2 + 1 ))
    L=$((H-5)); IW=$((W-2))   # linhas da lista (com folga em cima e embaixo) / largura interna
  }
  layout

  at() { printf '\e[%d;%dH' "$1" "$2"; }

  frame() {
    local r T col
    printf '\e[0;97;40m\e[2J\e[?25l'
    # barra azul do topo (titulo branco) e 2 barras azuis embaixo
    for r in 0 $((H-2)) $((H-1)); do
      at $((Y0+r)) "$X0"; printf '\e[0;97;44m\e[%dX' "$W"
    done
    for ((r=1; r<=H-3; r++)); do
      at $((Y0+r)) "$X0"; printf '\e[44m \e[40m'
      at $((Y0+r)) $((X0+W-1)); printf '\e[44m \e[40m'
    done
    T="${ZIP#/userdata/roms}"
    FNAME="${T##*/}"; DNAME="${T%/*}/"; DNAME="${DNAME^^}"
    T=" ${DNAME}${FNAME} "   # ex.: " /MEGADRIVE/hacks.zip "
    [ ${#T} -gt $((W-2)) ] && T=" ...${T: -$((W-8))}"   # muito longo: corta o comeco
    col=$(( X0 + (W - ${#T}) / 2 ))
    PRE="${T% }"; PRE="${PRE%"$FNAME"}"   # tudo antes do nome do arquivo, sem o espaco final
    at "$Y0" "$col"; printf '\e[5;1;92;44m%s\e[0;25;1;97;44m%s ' "$PRE" "$FNAME"
    T="<  Aceitar  >      <  Cancelar  >"
    col=$(( X0 + (W - ${#T}) / 2 ))
    at $((Y0+H-2)) "$col"; printf '\e[1;97;44m%s' "$T"
    PCOL=$(( X0 + W - 6 ))   # coluna da porcentagem, alinhada a direita da barra azul
  }

  # desenha uma linha da lista (1a letra verde; tarja da selecao azul escuro)
  row() {
    local r="$1" idx="$2" sel="$3" name first rest
    at "$r" $((X0+1))
    if [ "$sel" = 1 ]; then printf '\e[1;97;48;5;18m\e[%dX' "$IW"; else printf '\e[0;97;40m\e[%dX' "$IW"; fi
    [ "$idx" -ge "$N" ] && return
    name="${FILES[$idx]}"; name="${name:0:$((IW-3))}"
    first="${name:0:1}"; rest="${name:1}"
    at "$r" $((X0+2))
    if [ "$sel" = 1 ]; then
      printf '\e[1;92;48;5;18m%s\e[1;97;48;5;18m%s' "$first" "$rest"
    else
      printf '\e[1;92;40m%s\e[0;97;40m%s' "$first" "$rest"
    fi
  }

  SEL=0; TOP=0
  draw() {
    local k idx s pct
    if [ "$SEL" -lt "$TOP" ]; then TOP=$SEL; fi
    if [ "$SEL" -ge $((TOP+L)) ]; then TOP=$((SEL-L+1)); fi
    if [ $((TOP+L)) -gt "$N" ]; then TOP=$((N-L)); fi
    if [ "$TOP" -lt 0 ]; then TOP=0; fi
    for ((k=0; k<L; k++)); do
      idx=$((TOP+k)); s=0; [ "$idx" -eq "$SEL" ] && s=1
      row $((Y0+2+k)) "$idx" "$s"
    done
    at $((Y0+1)) $((X0+1)); printf '\e[0;97;40m\e[%dX' "$IW"
    at $((Y0+H-3)) $((X0+1)); printf '\e[0;97;40m\e[%dX' "$IW"
    # porcentagem da posicao, na barra azul de baixo, alinhada a direita
    pct=$(( (SEL+1)*100/N ))
    if [ $((PCOL+4)) -le $((X0+W-1)) ]; then at $((Y0+H-2)) "$PCOL"; printf '\e[1;97;44m%3d%%' "$pct"; fi
  }

  trap 'printf "\e[0m\e[2J\e[?25h"' EXIT
  frame; draw
  RESULT=""; OR=$R; OC=$C
  while true; do
    IFS= read -rsn1 -t 0.3 K; RC=$?
    if [ "$RC" -gt 128 ]; then
      # nenhuma tecla: se o terminal mudou de tamanho, recalcula e redesenha
      layout
      if [ "$R" != "$OR" ] || [ "$C" != "$OC" ]; then OR=$R; OC=$C; frame; draw; fi
      continue
    elif [ "$RC" -ne 0 ]; then
      break
    fi
    if [ "$K" = $'\e' ]; then
      IFS= read -rsn2 -t 0.05 K2
      case "$K2" in
        '[A') SEL=$(( (SEL-1+N) % N )) ;;
        '[B') SEL=$(( (SEL+1) % N )) ;;
        '[5') IFS= read -rsn1 -t 0.05 _; SEL=$(( SEL-L+1 )); [ "$SEL" -lt 0 ] && SEL=0 ;;
        '[6') IFS= read -rsn1 -t 0.05 _; SEL=$(( SEL+L-1 )); [ "$SEL" -ge "$N" ] && SEL=$((N-1)) ;;
        '') break ;;   # Esc = cancelar
      esac
      draw
    elif [ -z "$K" ] || [ "$K" = $'\r' ]; then
      RESULT="${FILES[$SEL]}"; break
    fi
  done
  printf '%s' "$RESULT" > "$OUT"
  touch "$OUT.ran"
  exit 0
fi

# modo lancamento (chamado pelo ES via emulatorlauncher)
ARGS=("$@")
ROM=""; IDX=-1; SYSTEM=""
for i in "${!ARGS[@]}"; do
  case "${ARGS[$i]}" in
    -rom)    IDX=$((i+1)); ROM="${ARGS[$IDX]}" ;;
    -system) SYSTEM="${ARGS[$((i+1))]}" ;;
  esac
done

TMP=/tmp/zipmenu
JOY=/userdata/system/zipmenu-joy.py

# so age nos sistemas da lista (e nunca em chamada recursiva)
if [ -z "$ZIPMENU_ACTIVE" ] && [ -n "$SYSTEM" ] && ! grep -qxF "$SYSTEM" "$EXCL" 2>/dev/null; then
  case "${ROM,,}" in
    *.zip)
      COUNT=$(unzip -Z1 "$ROM" 2>/dev/null | grep -vc '/$')
      if [ "$COUNT" -gt 1 ]; then
        rm -rf "$TMP"; mkdir -p "$TMP"
        export DISPLAY="${DISPLAY:-:0}"
        # ajudante de joystick: controle vira setas/Enter/Esc no menu
        JPID=""
        if [ -f "$JOY" ]; then
          python3 "$JOY" >/tmp/zipmenu-joy.log 2>&1 &
          JPID=$!
          sleep 0.5
        fi
        xterm -fullscreen -bg black -fg white -fa Monospace -fs 16 \
          -xrm 'XTerm*color4: #0a2a8c' \
          -e "$SELF" --pick "$ROM" "$TMP/choice"
        if [ -n "$JPID" ]; then kill "$JPID" 2>/dev/null; fi
        if [ -e "$TMP/choice.ran" ]; then
          if [ ! -s "$TMP/choice" ]; then rm -rf "$TMP"; exit 0; fi   # cancelou
          NAME=$(cat "$TMP/choice")
          EXTRACTED="$TMP/$(basename "$NAME")"
          unzip -p "$ROM" "$NAME" > "$EXTRACTED" || { rm -rf "$TMP"; exit 1; }
          ARGS[$IDX]="$EXTRACTED"
        fi
      fi
      ;;
  esac
fi

export ZIPMENU_ACTIVE=1
"$REAL" "${ARGS[@]}"
RC=$?
rm -rf "$TMP"
exit $RC
